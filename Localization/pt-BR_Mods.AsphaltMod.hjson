Configs: {
	AsphaltModConfig: {
		DisplayName: Configurações de Asphalt Mod

		BalanceChanges: {
			Label: Alterações de Balanço
			Tooltip:
				'''
				Reduzir as estatísticas da maioria dos itens de asfalto para os tornar balanceados com gameplay normal.
				Desative esta opção para as estatísticas superpoderosas originais de versões anteriores de Asphalt Mod.
				Note que os itens mais recentes podem não ser afetados por esta opção pois já foram feitos com balanço em mente.
				'''
		}
	}
}
